# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Use .env, not .env.local: the Prisma CLI reads .env only, so `prisma migrate`
# and `prisma db seed` will not see a .env.local. Next.js reads both.
# .env is gitignored. Never commit real credentials.

# --- Database ---------------------------------------------------------------
# Defaults below match docker-compose.yml, so `bash setup-db.sh` works as-is.
#
# DATABASE_URL  the connection the app uses. On a pooled host (e.g. Neon) this
#               is the POOLED URL, with `-pooler` in the hostname.
# DIRECT_URL    the connection the Prisma CLI uses for migrations. Same string
#               with `-pooler` removed — schema changes cannot go through a
#               connection pooler. For local Docker there is no pooler, so both
#               values are identical.
DATABASE_URL="postgresql://EdgePilot:EdgePilotTesting@localhost:5432/edgepilot"
DIRECT_URL="postgresql://EdgePilot:EdgePilotTesting@localhost:5432/edgepilot"

# --- AI Providers (SERVER-ONLY) ---------------------------------------------
# None of these may ever be prefixed NEXT_PUBLIC_. A NEXT_PUBLIC_ variable is
# inlined into the browser bundle at build time, which publishes it.
#
# OLLAMA_HOST  where the local runtime listens. On the host machine this is
#              localhost. Inside a container on the app network it is
#              http://ollama:11434 (see docker-compose.yml).
OLLAMA_HOST="http://localhost:11434"
OLLAMA_VISION_MODEL="gemma4"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_VISION_MODEL="gemini-3.6-flash"
GROQ_API_KEY="your-groq-api-key"
VISION_BENCHMARK_API_TOKEN="replace-with-a-long-random-token"

# --- Benchmark layer ---------------------------------------------------------
# BENCHMARK_TIMEOUT_MS       per-request budget for ONE iteration, in ms.
#                            Integer between 100 and 600000. Default 60000.
#                            A cold local model can take a minute to load on
#                            first call; raise this rather than reading the
#                            load time as a timeout.
# BENCHMARK_FALLBACK_ORDER   comma-separated provider slugs tried after the
#                            requested one, when it fails for a retryable
#                            reason. Default "ollama,groq,gemini".
#                            An invalid model name or a rejected key does NOT
#                            fall back — see docs/local-model-setup.md.
# BENCHMARK_ALLOW_DEMO       "true" registers the simulated demo adapter, for
#                            a machine with no Ollama and no API keys. Its
#                            numbers are labelled `simulated` and are NOT
#                            evidence. Leave unset in any real environment.
BENCHMARK_TIMEOUT_MS="60000"
BENCHMARK_FALLBACK_ORDER="ollama,groq,gemini"
BENCHMARK_ALLOW_DEMO="false"

# --- Auth -------------------------------------------------------------------
NEXTAUTH_SECRET="your-nextauth-secret"
NEXTAUTH_URL="http://localhost:3000"
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# --- Sentry -----------------------------------------------------------------
SENTRY_DSN="your-sentry-dsn"

# --- Public (exposed to the browser — never put a secret here) --------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
