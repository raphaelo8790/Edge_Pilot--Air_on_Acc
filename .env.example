# Copy this file to .env and fill in real values.
#
#   cp .env.example .env
#
# Use .env, not .env.local: the Prisma CLI reads .env only, so `prisma migrate`
# and `prisma db seed` will not see a .env.local. Next.js reads both.
# .env is gitignored. Never commit real credentials.

# --- Database ---------------------------------------------------------------
# Defaults below match docker-compose.yml, so `bash setup-db.sh` works as-is.
#
# DATABASE_URL  the connection the app uses. On a pooled host (e.g. Neon) this
#               is the POOLED URL, with `-pooler` in the hostname.
# DIRECT_URL    the connection the Prisma CLI uses for migrations. Same string
#               with `-pooler` removed — schema changes cannot go through a
#               connection pooler. For local Docker there is no pooler, so both
#               values are identical.
DATABASE_URL="postgresql://EdgePilot:EdgePilotTesting@localhost:5432/edgepilot"
DIRECT_URL="postgresql://EdgePilot:EdgePilotTesting@localhost:5432/edgepilot"

# --- AI Providers (SERVER-ONLY) ---------------------------------------------
# None of these may ever be prefixed NEXT_PUBLIC_. A NEXT_PUBLIC_ variable is
# inlined into the browser bundle at build time, which publishes it.
#
# OLLAMA_HOST  where the local runtime listens FROM THE SERVER'S POINT OF
#              VIEW. Used by the CLI scripts and GET /api/v1/local-runtime.
#              On the host machine this is localhost. Inside a container on
#              the app network it is http://ollama:11434 (docker-compose.yml).
#
#              The dashboard, comparison and vision pages do NOT use it: they
#              reach the VISITOR's Ollama from their browser tab at
#              http://localhost:11434, because a hosted server has no Ollama
#              and cannot reach a visitor's machine. For a hosted site the
#              visitor must allow the page's origin in Ollama's environment,
#              e.g. OLLAMA_ORIGINS=https://your-app.vercel.app, or the
#              browser's CORS check blocks the request before Ollama sees it.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_VISION_MODEL="gemma4"
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_VISION_MODEL="gemini-3.6-flash"
GROQ_API_KEY="your-groq-api-key"

# Billing tier per cloud provider: "free" or "paid". DECLARED, not detected -
# no inference API reports which tier a key is on. It matters because free and
# paid tiers commonly differ on whether the vendor retains your prompts and
# whether it may train on them. Leave unset and the privacy assessment says
# the tier is unknown rather than assuming one.
GEMINI_TIER=""
GROQ_TIER=""
VISION_BENCHMARK_API_TOKEN="replace-with-a-long-random-token"

# --- Benchmark layer ---------------------------------------------------------
# BENCHMARK_TIMEOUT_MS       per-request budget for ONE call, in ms.
#                            Integer between 100 and 600000.
#                            Every run makes one more call than requested and
#                            discards the first, because a local model that is
#                            not resident pays for being read into GPU memory
#                            on that call. Measured on this project: an 8B
#                            model took 36,445 ms to first token cold and
#                            369 ms warm. That discarded call still has to fit
#                            inside this budget, which is why the default is
#                            minutes and not seconds.
# BENCHMARK_FALLBACK_ORDER   comma-separated provider slugs tried after the
#                            requested one, when it fails for a retryable
#                            reason. Default "ollama,groq,gemini".
#                            An invalid model name or a rejected key does NOT
#                            fall back — see docs/local-model-setup.md.
# BENCHMARK_ALLOW_DEMO       "true" registers the simulated demo adapter, for
#                            a machine with no Ollama and no API keys. Its
#                            numbers are labelled `simulated` and are NOT
#                            evidence. Leave unset in any real environment.
BENCHMARK_TIMEOUT_MS="300000"
BENCHMARK_FALLBACK_ORDER="ollama,groq,gemini"

# ---------------------------------------------------------------------------
# HOSTED ON VERCEL - what to set in the project's Environment Variables
# ---------------------------------------------------------------------------
#   DATABASE_URL, DIRECT_URL     the Neon strings (pooled and direct).
#   GEMINI_API_KEY, GROQ_API_KEY the site's own keys, if visitors without
#                                their own should be able to run cloud models.
#   VISION_BENCHMARK_IN_APP=true so the vision page's cloud run works; server-
#                                key runs are capped per visitor per hour
#                                (src/core/quota/cloudRunQuota.ts).
#   BENCHMARK_FALLBACK_ORDER=groq,gemini
#                                there is no Ollama on the server, so it must
#                                not be in the chain a failed cloud run falls
#                                back to. Visitors' Ollama is reached from the
#                                browser and never through this setting.
#   OLLAMA_HOST                  leave unset; nothing on the server uses it.
# Redeploy after changing any of these - a running deployment keeps the old set.

BENCHMARK_ALLOW_DEMO="false"

# --- Auth -------------------------------------------------------------------
# There is none, deliberately.
#
# EdgePilot has no accounts and no sign-in. Ownership comes from a durable id
# the browser generates and stores itself (src/components/dashboard/session.ts),
# which is upserted into users.session_id on first use. That is enough to own
# workloads and benchmarks, it needs no password to leak, and it means a
# visitor can measure their own hardware without handing anything over.
#
# NEXTAUTH_SECRET and NEXTAUTH_URL used to be set here for a sign-in flow that
# does not exist in this codebase: zero files import next-auth. The variables
# were configuration for nothing. `next-auth` is still listed as a dependency
# in package.json with no importer - removing it changes the lockfile and
# conflicts with the auth work in the other branch, so that is a call for the
# Integration Lead rather than a silent deletion here.

# --- Sentry -----------------------------------------------------------------
SENTRY_DSN="your-sentry-dsn"

# --- Public (exposed to the browser — never put a secret here) --------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Lets the vision dashboard run the built-in 21-image dataset from a button
# instead of only from the terminal.
#
# Off by default on purpose. Next.js exposes server actions as POST endpoints,
# so this is an open "spend the server's API quota" button: a cloud run is 21
# requests to Gemini or Groq with the SERVER's key (a visitor who pasted their
# own key on /setup spends their own instead). Turn it on for local use, and
# on a hosted site only if you are happy with visitors spending your quota.
#
# It gates CLOUD runs only. A local (Ollama) run from the page happens in the
# visitor's browser against their own machine and never touches this server.
#
# This is NOT a secret and must never be prefixed NEXT_PUBLIC_ — it is read
# server-side only, and the API token below stays server-side regardless.
VISION_BENCHMARK_IN_APP="false"
