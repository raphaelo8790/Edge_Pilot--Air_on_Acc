{
  "artefact": "benchmark failure-mode evidence",
  "generated_by": "npm run bench:evidence:failures",
  "what_this_proves": "Each documented error code is produced by the condition it describes, and the runner falls back exactly when the code is retryable.",
  "what_this_does_not_prove": "Nothing about latency, throughput or model quality. The transport is scripted and the clock is a fixed stepper, so every duration below is an artefact of the harness, not a measurement. Real figures come from `npm run bench:run`.",
  "harness": {
    "transport": "fetch replaced with scripted responses; no network call is made",
    "clock": "stepped by 10 ms on each read",
    "providers_exercised": [
      "ollama",
      "gemini",
      "groq"
    ]
  },
  "error_code_reference": [
    {
      "code": "timeout",
      "http_status": 504,
      "retryable": true,
      "explanation": "The provider did not answer within BENCHMARK_TIMEOUT_MS. The request was aborted; no partial result is recorded as measured."
    },
    {
      "code": "local_unavailable",
      "http_status": 503,
      "retryable": true,
      "explanation": "Nothing is listening on OLLAMA_HOST. Start the runtime (docker compose --profile ollama up -d) or correct the host."
    },
    {
      "code": "invalid_model",
      "http_status": 422,
      "retryable": false,
      "explanation": "The model name is not available on that provider. This is a request error, so the runner does not fall back — a different provider would not make the name correct."
    },
    {
      "code": "unauthorized",
      "http_status": 502,
      "retryable": false,
      "explanation": "The provider rejected the credential. Fix the key in .env; falling back would hide a configuration fault."
    },
    {
      "code": "rate_limited",
      "http_status": 429,
      "retryable": true,
      "explanation": "The provider applied a rate limit or quota. The runner may fall back to another provider."
    },
    {
      "code": "invalid_response",
      "http_status": 502,
      "retryable": true,
      "explanation": "The provider answered with a payload that failed schema validation. Treated as a provider fault, not as a measurement."
    },
    {
      "code": "not_configured",
      "http_status": 503,
      "retryable": true,
      "explanation": "This provider has no credential or host in the current environment, so it was never called."
    },
    {
      "code": "provider_error",
      "http_status": 502,
      "retryable": true,
      "explanation": "The provider returned an error that does not map onto a more specific code."
    }
  ],
