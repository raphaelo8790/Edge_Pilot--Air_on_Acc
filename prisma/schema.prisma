// EdgePilot AI — Prisma schema
//
// Table/column names are snake_case in the database and camelCase in TypeScript.
// Do not rename a @map() value without a migration: the API responses and the
// column names are contractually linked (e.g. providers.is_active is what
// /api/v1/providers returns as `is_active`).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // url        = the connection the running app uses. On Neon this is the
  //              POOLED host (…-pooler.…) — it survives many short-lived
  //              serverless connections.
  // directUrl  = the connection the Prisma CLI uses for migrations. Must be
  //              the UNPOOLED host (same string, `-pooler` removed), because
  //              schema changes cannot run through pgBouncer.
  //
  // For local Docker Postgres there is no pooler, so both are the same string.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Owner of workloads and benchmarks.
///
/// Moving away from accounts: `sessionId` is a client-generated identifier so
/// a user can own rows without registering. It is added ALONGSIDE `email`
/// rather than replacing it, because dropping a column that main's seed
/// script and auth flow still read would break them at runtime, and the data
/// would not be recoverable. Once nothing reads `email` or `name`, a later
/// migration can drop them.
///
/// A note for whoever does that: do not key this table on the rotating
/// session id used by the activity log. That one expires after two hours,
/// and rows owned by an expired session would be orphaned. This wants a
/// durable per-installation identifier, which happens to be supplied the
/// same way.
model User {
  id        String   @id @default(uuid())
  /// Nullable since accounts became optional. Retained while main still uses it.
  email     String?  @unique
  /// Retained for the same reason. Nothing new should write to it.
  name      String?
  /// Client-generated durable owner id. Null for rows created before this.
  sessionId String?  @unique @map("session_id")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workloads  Workload[]
  benchmarks Benchmark[]

  @@map("users")
}

model Workload {
  id           String   @id @default(uuid())
  taskType     String   @map("task_type")
  inputFormat  String   @map("input_format")
  outputFormat String   @map("output_format")
  constraints  Json     @default("{}")
  userId       String   @map("user_id")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  benchmarks Benchmark[]

  @@index([userId])
  @@map("workloads")
}


// Shared catalog reference data, not user-owned. Retire a provider by setting
// isActive = false rather than deleting it — deleting one is blocked while any
// benchmark still references it (see Benchmark.provider below), because the
// benchmark history has to keep saying which provider produced it.
model Provider {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String
  baseUrl   String?  @map("base_url")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())

  benchmarks Benchmark[]

  @@map("providers")
}

model Benchmark {
  id          String    @id @default(uuid())
  workloadId  String    @map("workload_id")
  providerId  String    @map("provider_id")
  model       String
  prompt      String
  iterations  Int       @default(1)
  status      String    @default("pending")
  userId      String    @map("user_id")
  createdAt   DateTime  @default(now())
  completedAt DateTime? @map("completed_at")

  workload Workload @relation(fields: [workloadId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // No cascade: a provider cannot be deleted out from under a recorded run.
  provider Provider @relation(fields: [providerId], references: [id])

  results   BenchmarkResult[]
  readiness ReadinessScore?

  @@index([workloadId])
  @@index([providerId])
  @@index([userId])
  @@map("benchmarks")
}

model BenchmarkResult {
  id              String   @id @default(uuid())
  benchmarkId     String   @map("benchmark_id")
  iteration       Int
  latencyMs       Float    @map("latency_ms")
  tokensPerSecond Float?   @map("tokens_per_second")
  ttftMs          Float?   @map("ttft_ms")
  success         Boolean  @default(true)
  errorMessage    String?  @map("error_message")
  /// True for the discarded first call that loads the model. Excluded from
  /// every average - see BenchmarkRunner. Defaults false so rows written
  /// before this column existed keep their meaning.
  warmup          Boolean  @default(false)
  createdAt       DateTime @default(now())

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@index([benchmarkId])
  @@map("benchmark_results")
}

model ReadinessScore {
  id               String   @id @default(uuid())
  benchmarkId      String   @unique @map("benchmark_id")
  // Nullable: a cloud run has no hardware fit, and an unobserved local run
  // must not be recorded as 0. See HardwareFitAssessor.
  hardwareFit      Int?     @map("hardware_fit")
  latencyScore     Int      @map("latency_score")
  // Nullable since privacy stopped being a numeric component of the score.
  // Historic rows keep their value; new rows record `privacyClass` instead.
  privacyScore     Int?     @map("privacy_score")
  privacyClass     String?  @map("privacy_class")
  costScore        Int      @map("cost_score")
  reliabilityScore Int      @map("reliability_score")
  overallReadiness Int      @map("overall_readiness")
  recommendation   String
  evidence         Json     @default("[]")
  limitations      Json     @default("[]")
  createdAt        DateTime @default(now())

  benchmark Benchmark @relation(fields: [benchmarkId], references: [id], onDelete: Cascade)

  @@map("readiness_scores")
}

/// A session log a user chose to send us.
/// Written only on an explicit, confirmed request - never as a side effect of
/// running a benchmark. `payload` holds the same redacted document the user can
/// download, with one further restriction applied on the way in: prompt text is
/// stripped even when the session had opted into recording it locally, because
/// consenting to keep a transcript on your own machine is not consenting to
/// upload it.
/// The session activity log, one row per event, keyed by the browser's own
/// session id. Written by every route and server action that records to the
/// log; read back by /api/v1/session-log and the share preview. Hosted, this
/// is the only place a log can live: a serverless function's memory does not
/// survive the request, let alone until the visitor asks for the export.
/// Prompt text is never here - the recorder digests it before the row is
/// written - and rows are pruned after a retention window.
model SessionEvent {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  at            DateTime
  level         String
  category      String
  message       String
  correlationId String?  @map("correlation_id")
  data          Json     @default("{}")

  @@index([sessionId, at])
  @@index([at])
  @@map("session_events")
}

/// No account, no user id, no IP. The session id is client-generated and is the
/// only identifier here; it is not traceable to a person by us.
model SharedFinding {
  id                 String   @id @default(uuid())
  sessionId          String   @map("session_id")
  /// Schema marker of the payload, e.g. "edgepilot.session-log.v1".
  schemaVersion      String   @map("schema_version")
  payload            Json
  eventCount         Int      @map("event_count")
  /// Optional free-text note the sharer chose to attach.
  note               String?
  /// What the user was shown and agreed to, stored with the record.
  consentStatement   String   @map("consent_statement")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([sessionId])
  @@index([createdAt])
  @@map("shared_findings")
}

model RateLimit {
  id         String   @id @default(uuid())
  identifier String
  timestamp  DateTime @default(now())

  @@index([identifier, timestamp])
  @@map("rate_limits")
}
