{
  "name": "edgepilot-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run vision:fixtures",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "pretest": "npm run vision:fixtures && npm run vision:evidence:controlled",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:e2e": "playwright test",
    "vision:fixtures": "node scripts/vision-benchmark/generate-fixtures.mjs",
    "vision:validate": "node --import tsx scripts/vision-benchmark/validate-dataset.ts",
    "vision:evidence:controlled": "node --import tsx scripts/vision-benchmark/generate-controlled-evidence.ts",
    "vision:run:ollama": "node --import tsx scripts/vision-benchmark/run.ts --provider=ollama",
    "vision:run:gemini": "node --import tsx scripts/vision-benchmark/run.ts --provider=gemini",
    "bench:evidence:failures": "node --import tsx scripts/benchmark/capture-failure-evidence.ts",
    "bench:run": "node --import tsx scripts/benchmark/run-benchmark.ts",
    "bench:clean-start": "node --import tsx scripts/benchmark/capture-clean-start.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset",
    "db:neon:deploy": "dotenv -e .env.neon -- prisma migrate deploy",
    "db:neon:seed": "dotenv -e .env.neon -- prisma db seed",
    "db:neon:studio": "dotenv -e .env.neon -- prisma studio"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@hookform/resolvers": "^3.3.0",
    "@prisma/client": "^5.0.0",
    "@sentry/nextjs": "10.67.0",
    "@tanstack/react-query": "^5.0.0",
    "@tanstack/react-table": "^8.0.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.0.0",
    "framer-motion": "12.42.2",
    "groq-sdk": "^0.5.0",
    "lucide-react": "0.475.0",
    "next": "^16.0.0",
    "next-auth": "^4.24.15",
    "nuqs": "2.9.1",
    "ollama": "^0.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.48.0",
    "recharts": "^2.10.0",
    "sharp": "0.35.3",
    "tailwind-merge": "^2.0.0",
    "uuid": "^14.0.1",
    "zod": "^3.22.0",
    "zustand": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "16.3.2",
    "@types/jest": "^29.0.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.0.0",
    "jest": "^29.0.0",
    "postcss": "8.5.22",
    "prisma": "^5.0.0",
    "tailwindcss": "^4.0.0",
    "ts-jest": "^29.0.0",
    "tsx": "4.23.1",
    "typescript": "^5.3.0"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "sharp": "0.35.3",
    "postcss": "8.5.22"
  }
}
